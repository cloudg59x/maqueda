# Copy to .env and adjust. Never commit .env.
# All variables are read by Next.js (src/) and the worker (src/worker/).

# --- Database -------------------------------------------------------------
# Postgres connection string. Matches compose.yml defaults when running `npm run db:up`.
DATABASE_URL="postgresql://postgres:password@localhost:5433/maqueda?schema=public"

# --- Auth -----------------------------------------------------------------
# Secret used to sign admin session JWTs (HS256). Use a long random string:
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Credentials created by `npm run db:seed` if no user exists yet.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="AdminPass123!"

# --- Blockchain -----------------------------------------------------------
# Chain the worker monitors. Hex chain id as reported by the wallet.
#   0xaa36a7 = Ethereum Sepolia (testnet, use in development)
#   0x1      = Ethereum Mainnet
CHAIN_ID="0xaa36a7"

# JSON-RPC endpoint for CHAIN_ID. Any provider works (Alchemy, Infura, public).
# Public Sepolia example (rate limited, fine for dev):
#   https://ethereum-sepolia-rpc.publicnode.com
# Public mainnet example:
#   https://ethereum-rpc.publicnode.com
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# --- Prices ---------------------------------------------------------------
# CoinGecko public API base. No key needed for /simple/price at our request rate.
COINGECKO_BASE_URL="https://api.coingecko.com/api/v3"

# --- dApp integration -----------------------------------------------------
# Comma-separated origins allowed to call /api/clients/* (CORS).
# The GitHub Pages dApp origin goes here in production; "*" allows everything (dev only).
DAPP_ORIGINS="*"

# Public URL of this admin app (used for absolute links in notifications).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram bot token and chat id are NOT env vars: set them in Admin -> Settings.
